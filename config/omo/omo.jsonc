{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  "[opencode]": {
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true,
      "git_env_prefix": "GIT_MASTER=1"
    },
    "tmux": {
      "agent_pane_min_width": 30,
      "enabled": true,
      "layout": "main-vertical",
      "isolation": "inline",
      "main_pane_min_width": 60,
      "main_pane_size": 50
    }
  },

  "profiles": {
    "perso": {
      "[opencode]": {
        "git_master": {
          "commit_footer": true,
          "include_co_authored_by": true,
          "git_env_prefix": "GIT_MASTER=1"
        },
        "agents": {
          "sisyphus": { "model": "openai/gpt-5.6-sol", "reasoning": "medium" },
          "hephaestus": { "model": "openai/gpt-5.6-luna", "reasoning": "high" },
          "prometheus": { "model": "openai/gpt-5.6-luna", "reasoning": "high" },
          "metis": { "model": "openai/gpt-5.6-luna", "reasoning": "high" },
          "momus": { "model": "openai/gpt-5.6-luna", "reasoning": "high" },
          "oracle": { "model": "openai/gpt-5.6-luna", "reasoning": "max" },
          "atlas": { "model": "openai/gpt-5.6-luna", "reasoning": "high" },
          "sisyphus-junior": { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
          "explore": { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
          "librarian": { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
          "multimodal-looker": { "model": "openai/gpt-5.6-luna", "reasoning": "low" }
        },
        "categories": {
          "quick": { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
          "unspecified-low": { "model": "openai/gpt-5.6-luna", "reasoning": "medium" },
          "unspecified-high": { "model": "openai/gpt-5.6-luna", "reasoning": "xhigh" },
          "deep": { "model": "openai/gpt-5.6-sol", "reasoning": "medium" },
          "ultrabrain": { "model": "openai/gpt-5.6-sol", "reasoning": "high" }
        },
        "background_task": {
          "defaultConcurrency": 3,
          "providerConcurrency": { "openai": 3 },
          "modelConcurrency": { "openai/gpt-5.6-sol": 1 }
        }
      }
    },

    "work": {
      "[opencode]": {
        "git_master": {
          "commit_footer": true,
          "include_co_authored_by": true,
          "git_env_prefix": "GIT_MASTER=1"
        },
        "agents": {
          "sisyphus": { "model": "github-copilot/claude-sonnet-5", "reasoning": "high" },
          "hephaestus": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "high" },
          "prometheus": { "model": "github-copilot/gpt-5.6-sol", "reasoning": "medium" },
          "metis": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "xhigh" },
          "momus": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "medium" },
          "oracle": { "model": "github-copilot/gpt-5.6-sol", "reasoning": "medium" },
          "atlas": { "model": "github-copilot/gpt-5.6-sol", "reasoning": "medium" },
          "sisyphus-junior": { "model": "github-copilot/claude-haiku-4-5", "reasoning": "low" },
          "explore": { "model": "github-copilot/claude-haiku-4-5", "reasoning": "low" },
          "librarian": { "model": "github-copilot/claude-haiku-4-5", "reasoning": "low" },
          "multimodal-looker": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "low" }
        },
        "categories": {
          "quick": { "model": "github-copilot/claude-haiku-4-5", "reasoning": "low" },
          "unspecified-low": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "medium" },
          "unspecified-high": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "xhigh" },
          "deep": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "high" },
          "ultrabrain": { "model": "github-copilot/gpt-5.6-luna", "reasoning": "xhigh" }
        },
        "background_task": {
          "defaultConcurrency": 3,
          "providerConcurrency": { "github-copilot": 3 },
          "modelConcurrency": { "github-copilot/gpt-5.6-sol": 1 }
        }
      }
    },

    "perso-light": {
      "[opencode]": {
        "git_master": {
          "commit_footer": true,
          "include_co_authored_by": true,
          "git_env_prefix": "GIT_MASTER=1"
        },
        "sisyphus_agent": { "disabled": true }
      }
    },

    "work-light": {
      "[opencode]": {
        "git_master": {
          "commit_footer": true,
          "include_co_authored_by": true,
          "git_env_prefix": "GIT_MASTER=1"
        },
        "sisyphus_agent": { "disabled": true }
      }
    }
  }
}
