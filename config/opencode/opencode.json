{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.4-mini",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 25600
  },
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    }
  },
  "lsp": true,
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "oh-my-openagent@latest",
    "@dietrichgebert/ponytail",
    "./plugins/cmux-session.js",
    "./plugins/cmux-feed.js"
  ]
}