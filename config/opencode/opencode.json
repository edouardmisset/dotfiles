{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.4-mini",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 25600
  },
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    }
  },
  "agents": {
    "hephaestus": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "oracle": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "momus": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "metis": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "prometheus": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "atlas": { "model": "openai/gpt-5.6-luna", "variant": "medium" },
    "sisyphus-junior": { "model": "openai/gpt-5.6-luna", "variant": "medium" },
    "multimodal-looker": { "model": "openai/gpt-5.6-luna", "variant": "low" },
    "explore": { "model": "openai/gpt-5.6-luna-fast", "variant": "low" },
    "librarian": { "model": "openai/gpt-5.6-luna-fast", "variant": "low" }
  },
  "categories": {
    "visual-engineering": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "ultrabrain": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "deep": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "artistry": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "quick": { "model": "openai/gpt-5.6-luna-fast", "variant": "low" },
    "unspecified-low": { "model": "openai/gpt-5.6-luna", "variant": "low" },
    "unspecified-high": { "model": "openai/gpt-5.6-luna", "variant": "medium" },
    "writing": { "model": "openai/gpt-5.6-luna", "variant": "low" }
  },
  "lsp": true,
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "oh-my-openagent@latest",
    "@dietrichgebert/ponytail",
    "./plugins/cmux-session.js",
    "./plugins/cmux-feed.js"
  ]
}