{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 25600
  },
  "model": "openai/gpt-5.6-sol",
  "agents": {
    "build": { "model": "openai/gpt-5.6-sol#medium" },
    "plan": { "model": "openai/gpt-5.6-sol#medium" },
    "title": { "model": "openai/gpt-5.4-mini" },
    "hephaestus": { "model": "openai/gpt-5.6-luna#high" },
    "oracle": { "model": "openai/gpt-5.6-luna#xhigh" },
    "momus": { "model": "openai/gpt-5.6-luna#high" },
    "metis": { "model": "openai/gpt-5.6-luna#high" },
    "prometheus": { "model": "openai/gpt-5.6-luna#xhigh" },
    "atlas": { "model": "openai/gpt-5.6-luna#medium" },
    "sisyphus-junior": { "model": "openai/gpt-5.6-luna#medium" },
    "multimodal-looker": { "model": "openai/gpt-5.6-luna#low" },
    "explore": { "model": "openai/gpt-5.6-luna-fast#low" },
    "librarian": { "model": "openai/gpt-5.6-luna-fast#low" }
  },
  "categories": {
    "visual-engineering": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "ultrabrain": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "deep": { "model": "openai/gpt-5.6-luna", "variant": "high" },
    "artistry": { "model": "openai/gpt-5.6-luna", "variant": "xhigh" },
    "quick": { "model": "openai/gpt-5.6-luna-fast", "variant": "low" },
    "unspecified-low": { "model": "openai/gpt-5.6-luna", "variant": "low" },
    "unspecified-high": { "model": "openai/gpt-5.6-luna", "variant": "medium" },
    "writing": { "model": "openai/gpt-5.6-luna", "variant": "low" }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {}
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp"
        ],
        "disabled": true
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "oh-my-openagent@latest",
    "@dietrichgebert/ponytail",
    { "package": "./plugins/cmux-session" },
    { "package": "./plugins/cmux-feed" }
  ]
}